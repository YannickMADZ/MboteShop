# Variante SANS téléchargement npm, pour une connexion lente ou filtrée.
# Les dépendances (backend/node_modules) sont fournies déjà installées dans le zip.
# Utilisation : docker compose -f docker-compose.hors-ligne.yml up --build
# (Render utilise le Dockerfile normal.)
FROM node:22-alpine

WORKDIR /app/backend

COPY backend/ ./
RUN node -e "require('express'); require('mongoose'); require('cors'); console.log('✅ Dépendances présentes (mode hors ligne)')"

COPY frontend/ /app/frontend/

ENV NODE_ENV=production \
    PORT=3000

EXPOSE 3000
USER node

CMD ["node", "server.js"]
